{
  "trailingSlash": true,
  "rewrites": [
    { "source": "/games/:slug", "destination": "/spa.html" },
    { "source": "/games/:slug/", "destination": "/spa.html" },
    { "source": "/category/:slug", "destination": "/spa.html" },
    { "source": "/category/:slug/", "destination": "/spa.html" },
    { "source": "/search", "destination": "/spa.html" },
    { "source": "/search/", "destination": "/spa.html" },
    { "source": "/offers", "destination": "/spa.html" },
    { "source": "/offers/", "destination": "/spa.html" },
    { "source": "/admin", "destination": "/spa.html" },
    { "source": "/admin/", "destination": "/spa.html" },
    { "source": "/admin/:path*", "destination": "/spa.html" },
    { "source": "/admin/:path*/", "destination": "/spa.html" }
  ]
}
